# Repository root. Export this before starting Emacs if dotfiles should
# automatically load elisp/starintel-social.el.
STARINTEL_SOCIAL_ROOT=

# Local StarIntel checkouts.
STARINTEL_SERVER_DIR=
STARINTEL_AUTO_DIG_DIR=
STARINTEL_AUTO_RESEARCH_DIR=
STARINTEL_QUASAR_DIR=
STARINTEL_QUASAR_UI_DIR=

# Optional parent directory used to discover additional local `star*` and
# `quasar*` checkouts. Keep it outside this repository.
STARINTEL_REPOSITORIES_DIR=

# Optional parent containing versioned workspace roots such as starintelV4,
# starintelV5, and later.
STARINTEL_WORKSPACE_ROOT=

# Optional live server endpoint used only by commands that explicitly need it.
STARINTEL_API_URL=

# Optional editorial model adapter. Normal editing/export does not require it.
STARINTEL_LLM_PROVIDER=
STARINTEL_LLM_MODEL=

# media-gen uses Prolog-RLM directly. nix develop sets PROLOG_RLM_DIR to the
# pinned dependency automatically; set this only to test another inspected
# local checkout deliberately.
PROLOG_RLM_DIR=

# Media providers. The current deterministic/CI slice uses the fake Prolog
# provider and spends no money. Verify current official provider APIs before
# enabling live adapters. Concrete model identifiers are deliberately blank:
# select them from verified current provider docs at deployment/evaluation time.
OPENAI_API_KEY=
GEMINI_API_KEY=
STARINTEL_IMAGE_OPENAI_MODEL=
STARINTEL_IMAGE_GOOGLE_MODEL=
STARINTEL_VIDEO_GOOGLE_MODEL=
STARINTEL_VIDEO_OPENAI_MODEL=

# Additional character-catalog sources are future Prolog catalog inputs. Keep
# generated caches outside Git.
STARINTEL_CHARACTER_CATALOGS=

# Deep research remains owned by Auto Research. This selector documents that
# this repository should use the Auto Research adapter boundary rather than
# vendoring a research engine.
STARINTEL_DEEP_RESEARCH_INTEGRATION=auto-research-adapter

# Agent Zero installation root, when installing repository skills for Agent Zero.
# Example: /a0/usr
A0_USR=
