#!/usr/bin/env bash
# Build the static site into ./site using the configured environment.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

# Optional overrides: externals JSON spec and per-vhost base URLs.
extra_args=()
if [[ -n "${STARINTEL_SITE_EXTERNALS:-}" ]]; then
  extra_args+=(--externals "$STARINTEL_SITE_EXTERNALS")
fi
if [[ -n "${STARINTEL_SITE_BASE_MAP:-}" ]]; then
  extra_args+=(--base-map "$STARINTEL_SITE_BASE_MAP")
fi

export PYTHONPATH="$root/site_builder/src:$PYTHONPATH"
python3 -m starintel_site_builder.cli build \
  --root "$root" \
  --out "$root/site" \
  --build-dir "$root/.build" \
  "${extra_args[@]}"
